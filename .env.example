# ---------------------------------------------------------------------------
# Google OAuth (from Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
# ---------------------------------------------------------------------------
CLIENT_ID=
CLIENT_SECRET=

# Only needed when NOT running on Railway. Defaults to
# http://localhost:3000/oauth2callback
# REDIRECT_URI=

# ---------------------------------------------------------------------------
# Dashboard access
# ---------------------------------------------------------------------------
# Fallback shared password (kept for backwards compatibility with v1).
DASHBOARD_PASSWORD=ytrevenue2024

# Per-user logins: "name:password" pairs separated by commas.
# Example: DASHBOARD_USERS=fatlum:secret1,colleague1:secret2,colleague2:secret3
DASHBOARD_USERS=

# ---------------------------------------------------------------------------
# Railway token backup (layer 3 of token persistence)
# ---------------------------------------------------------------------------
RAILWAY_API_TOKEN=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
# STORED_TOKENS is written automatically by the app - do not edit by hand.
STORED_TOKENS=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
PORT=3000
CURRENCY=SEK
# How far back the first full backfill reaches.
BACKFILL_START=2024-01-01
# Days of recent history re-fetched on every sync (YouTube revises recent data).
SYNC_REFRESH_DAYS=14
# Minutes between background syncs.
SYNC_INTERVAL_MINUTES=180
